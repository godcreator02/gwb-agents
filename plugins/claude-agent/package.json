{
  "name": "@godcreator/gwb-claude-agent",
  "version": "0.1.3",
  "description": "经 Claude Agent SDK 跑无界面的 agent 会话，模型可换（本机 Claude 或任何 Anthropic 兼容接口）：服务 gwbClaudeAgent 新建、续聊、打断、读进度；SDK 由用户用 npm 装，不打包。",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "LICENSE"
  ],
  "keywords": [
    "gwb-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/godcreator02/gwb-agents.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "node build.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "^0.6.2",
    "@godcreator/gwb-data": "^0.1.12",
    "@godcreator/gwb-kernel-desktop": "^0.10.1",
    "@godcreator/gwb-settings": "^0.4.2",
    "@godcreator/gwb-skills": "^0.4.7",
    "cordis": "^4.0.0-rc.10"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-skills": {
      "optional": true
    }
  },
  "devDependencies": {
    "@godcreator/gwb-settings": "^0.4.2",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "esbuild": "^0.28.2",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
