{
  "name": "@godcreator/gwb-claudecode",
  "version": "0.4.0",
  "description": "Claude Code 原生 CLI 会话：服务 gwbClaudecode 创建、续聊、读进程事件保存的状态；claudecode.* 命令是它给 agent 的薄封装。",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "gwb-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-agents.git"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "build": "node build.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "^0.6.0",
    "@godcreator/gwb-kernel-desktop": "^0.10.1",
    "@godcreator/gwb-settings": "^0.4.0",
    "@godcreator/gwb-data": "^0.1.12",
    "cordis": "^4.0.0-rc.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "esbuild": "^0.28.2",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
