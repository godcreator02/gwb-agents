{
  "name": "@godcreator/gwb-zcode",
  "version": "0.4.2",
  "description": "给运行中的 ZCode 桌面端派任务：服务 gwbZcode 切工作区、新建或续聊、完全访问、发出即返回、读最新一轮、归档；zcode.* 命令是它给 agent 的薄封装。",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "gwb-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-agents.git"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "build": "node build.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "^0.6.0",
    "@godcreator/gwb-kernel-desktop": "^0.10.1",
    "@godcreator/gwb-skills": "^0.4.7",
    "cordis": "^4.0.0-rc.10"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-skills": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "esbuild": "^0.28.2",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
